// The menus: clicking Format in the title bar opens it, and clicking Bold
// in it runs Bold on the selection.
(
    size: (900, 700),
    events: [
        Type("Bold by menu"),
        Key("Primary+A"),
        // Format's title, then Bold, its first item.
        Click(217, 20),
        Click(230, 58),
    ],
    expect: [("Body", "Bold by menu")],
    marks: [("Bold by menu", ["bold"])],
)
