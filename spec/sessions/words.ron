// On a Mac, Option and the arrows move by words, forward to a word's end
// and back to its start, and with Shift they select (project owner,
// 2026-10-23, review dcn5ejrd; words-pc.ron has Windows' and Linux's). At a
// paragraph's edge they go on into the next or the one before. Moving and
// selecting by sentences are commands.
(
    size: (900, 700),
    mac: true,
    events: [
        Type("The cat's toy is lost. Find it."),
        Key("Primary+Home"),
        // To the end of "The", then of "cat's".
        Repeat("Alt+Right", 2),
        Type(" red"),
        // Back to the start of "red", and "red" selected.
        Key("Alt+Left"),
        Key("Alt+Shift+Right"),
        // On to the end of the sentence.
        Command("select-sentence-right"),
        Command("copy"),
        // To the end of the next sentence.
        Command("sentence-right"),
        Type(" Now."),
        Key("Enter"),
        Type("Second line"),
        // Back past "line" and "Second", into the paragraph before, to the
        // start of its last word.
        Repeat("Alt+Left", 3),
        Type("X"),
        // Forward past "XNow" and its full stop, and into the next
        // paragraph, to the end of its first word.
        Repeat("Alt+Right", 3),
        Type("?"),
    ],
    expect: [
        ("Body", "The cat's red toy is lost. Find it. XNow."),
        ("Body", "Second? line"),
    ],
    clipboard: Some("red toy is lost."),
)
