// A table typed with the keyboard (docs/ROADMAP.md, M2 stage 2): the table
// command puts one in, Tab goes from cell to cell and makes a row after
// the last, Shift+Tab goes back, Enter goes to the cell below and makes a
// row at the end, and Down leaves the table. The header row's cells are in
// Table Header (review sjj5ak5a), the others in no style of their own.
(
    size: (900, 700),
    events: [
        Type("Prices"),
        Key("Enter"),
        Key("Primary+Shift+T"),
        Type("Item"),
        Key("Tab"),
        Type("Price"),
        Key("Tab"),
        Type("Tea"),
        Key("Tab"),
        Type("2"),
        Key("Tab"),
        Type("Cakes"),
        Key("Tab"),
        Type("3"),
        Key("Shift+Tab"),
        Key("Backspace"),
        Key("Down"),
        Type("Prices include tax."),
        Key("Up"),
        Key("Enter"),
        Type("Scone"),
    ],
    expect: [
        ("Body", "Prices"),
        ("Table Header", "Item"),
        ("Table Header", "Price"),
        ("", "Tea"),
        ("", "2"),
        ("", "Cake"),
        ("", "3"),
        ("", "Scone"),
        ("", ""),
        ("Body", "Prices include tax."),
    ],
    outline: Some([
        "Body: Prices",
        "table",
        "  row",
        "    Table Header: Item",
        "    Table Header: Price",
        "  row",
        "    Body: Tea",
        "    Body: 2",
        "  row",
        "    Body: Cake",
        "    Body: 3",
        "  row",
        "    Body: Scone",
        "    Body: ",
        "Body: Prices include tax.",
    ]),
)
