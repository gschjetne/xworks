// Lists typed with the keyboard (docs/ROADMAP.md, M2 stage 2): Enter
// starts the next item, Tab nests an item in the one before, Enter in an
// empty item takes it out a level, and out of the list at the top.
// Backspace at an item's start takes it out of the list, and the items
// after it stay a list, numbered on. Undo puts it back, and the list
// survives closing and opening the document.
(
    size: (900, 700),
    events: [
        Type("Shopping"),
        Key("Enter"),
        Key("Primary+Shift+8"),
        Type("eggs"),
        Key("Enter"),
        Type("milk"),
        Key("Enter"),
        Key("Tab"),
        Type("whole"),
        Key("Enter"),
        Type("skimmed"),
        Key("Enter"),
        // An empty nested item: back to the first level.
        Key("Enter"),
        Type("bread"),
        Key("Enter"),
        // An empty item at the first level: out of the list.
        Key("Enter"),
        Type("That's all."),
        Outline([
            "Body: Shopping",
            "list",
            "  item",
            "    Body: eggs",
            "  item",
            "    Body: milk",
            "    list",
            "      item",
            "        Body: whole",
            "      item",
            "        Body: skimmed",
            "  item",
            "    Body: bread",
            "Body: That's all.",
        ]),
        Key("Enter"),
        Key("Primary+Shift+7"),
        Type("first"),
        Key("Enter"),
        Type("second"),
        Key("Enter"),
        Type("third"),
        Key("Up"),
        Key("Home"),
        Key("Backspace"),
        Outline([
            "Body: Shopping",
            "list",
            "  item",
            "    Body: eggs",
            "  item",
            "    Body: milk",
            "    list",
            "      item",
            "        Body: whole",
            "      item",
            "        Body: skimmed",
            "  item",
            "    Body: bread",
            "Body: That's all.",
            "list ordered",
            "  item",
            "    Body: first",
            "Body: second",
            "list ordered start 2",
            "  item",
            "    Body: third",
        ]),
        Key("Primary+Z"),
        Reopen,
    ],
    expect: [
        ("Body", "Shopping"),
        ("Body", "eggs"),
        ("Body", "milk"),
        ("Body", "whole"),
        ("Body", "skimmed"),
        ("Body", "bread"),
        ("Body", "That's all."),
        ("Body", "first"),
        ("Body", "second"),
        ("Body", "third"),
    ],
    outline: Some([
        "Body: Shopping",
        "list",
        "  item",
        "    Body: eggs",
        "  item",
        "    Body: milk",
        "    list",
        "      item",
        "        Body: whole",
        "      item",
        "        Body: skimmed",
        "  item",
        "    Body: bread",
        "Body: That's all.",
        "list ordered",
        "  item",
        "    Body: first",
        "  item",
        "    Body: second",
        "  item",
        "    Body: third",
    ]),
)
