// M1's commands and menus (docs/ROADMAP.md, M1 stage 9), and M2's for text
// (stage 3). Each command has an ID the app acts on, a title for menus, and
// maybe a shortcut: keys joined by "+", where "Primary" is Ctrl, or Command
// on a Mac. A shortcut that differs on a Mac in more than that is given for
// the Mac as `mac`: moving by words is Ctrl and an arrow on Windows and
// Linux, Option ("Alt") and an arrow on a Mac. Menus list command IDs in
// order, "-" for a separator.
(
    commands: [
        (id: "new", title: "New", shortcut: Some("Primary+N")),
        (id: "open", title: "Open…", shortcut: Some("Primary+O")),
        (id: "save-version", title: "Save a Version", shortcut: Some("Primary+S")),
        (id: "export-pdf", title: "Export as PDF", shortcut: Some("Primary+Shift+E")),
        (id: "print", title: "Print…", shortcut: Some("Primary+P")),
        (id: "quit", title: "Quit", shortcut: Some("Primary+Q")),

        (id: "undo", title: "Undo", shortcut: Some("Primary+Z")),
        (id: "redo", title: "Redo", shortcut: Some("Primary+Shift+Z")),
        (id: "cut", title: "Cut", shortcut: Some("Primary+X")),
        (id: "copy", title: "Copy", shortcut: Some("Primary+C")),
        (id: "paste", title: "Paste", shortcut: Some("Primary+V")),
        (id: "select-all", title: "Select All", shortcut: Some("Primary+A")),

        // Moving by words goes to a word's end going forward, and its start
        // going back, on every platform. Sentences have no shortcut: no
        // platform has one to follow, and the obvious keys are taken
        // (Ctrl+Alt and an arrow switches workspaces on Linux); a triple
        // click selects one.
        (id: "word-left", title: "Word Left", shortcut: Some("Primary+Left"), mac: Some("Alt+Left")),
        (id: "word-right", title: "Word Right", shortcut: Some("Primary+Right"), mac: Some("Alt+Right")),
        (id: "select-word-left", title: "Select Word Left", shortcut: Some("Primary+Shift+Left"), mac: Some("Alt+Shift+Left")),
        (id: "select-word-right", title: "Select Word Right", shortcut: Some("Primary+Shift+Right"), mac: Some("Alt+Shift+Right")),
        (id: "sentence-left", title: "Sentence Left", shortcut: None),
        (id: "sentence-right", title: "Sentence Right", shortcut: None),
        (id: "select-sentence-left", title: "Select Sentence Left", shortcut: None),
        (id: "select-sentence-right", title: "Select Sentence Right", shortcut: None),

        (id: "bold", title: "Bold", shortcut: Some("Primary+B")),
        (id: "italic", title: "Italic", shortcut: Some("Primary+I")),
        (id: "style-body", title: "Body", shortcut: Some("Primary+0")),
        (id: "style-heading-1", title: "Heading 1", shortcut: Some("Primary+1")),
        (id: "style-heading-2", title: "Heading 2", shortcut: Some("Primary+2")),
        (id: "style-heading-3", title: "Heading 3", shortcut: Some("Primary+3")),
        (id: "size-bigger", title: "Bigger", shortcut: Some("Primary+Shift+.")),
        (id: "size-smaller", title: "Smaller", shortcut: Some("Primary+Shift+,")),
        (id: "size-9", title: "9 pt", shortcut: None),
        (id: "size-10", title: "10 pt", shortcut: None),
        (id: "size-11", title: "11 pt", shortcut: None),
        (id: "size-12", title: "12 pt", shortcut: None),
        (id: "size-14", title: "14 pt", shortcut: None),
        (id: "size-18", title: "18 pt", shortcut: None),
        (id: "size-24", title: "24 pt", shortcut: None),
        (id: "align-start", title: "Align to Start", shortcut: Some("Primary+L")),
        (id: "align-center", title: "Centre", shortcut: Some("Primary+E")),
        (id: "align-end", title: "Align to End", shortcut: Some("Primary+R")),
        (id: "align-justify", title: "Justify", shortcut: Some("Primary+J")),

        // The language of the selected text, or with none selected, of the
        // caret's paragraph: language-TAG, TAG a BCP 47 tag. A new document
        // is in the system's language.
        (id: "language-en-US", title: "English (US)", shortcut: None),
        (id: "language-en-GB", title: "English (UK)", shortcut: None),
        (id: "language-de", title: "German", shortcut: None),
        (id: "language-fr", title: "French", shortcut: None),
        (id: "language-es", title: "Spanish", shortcut: None),
        (id: "language-nb", title: "Norwegian Bokmål", shortcut: None),
        (id: "language-nn", title: "Norwegian Nynorsk", shortcut: None),
        (id: "language-sv", title: "Swedish", shortcut: None),
        (id: "language-ru", title: "Russian", shortcut: None),
        (id: "language-el", title: "Greek", shortcut: None),
        (id: "language-ar", title: "Arabic", shortcut: None),
        (id: "language-he", title: "Hebrew", shortcut: None),
        (id: "language-ja", title: "Japanese", shortcut: None),
        (id: "language-ko", title: "Korean", shortcut: None),
        (id: "language-zh-Hans", title: "Chinese (Simplified)", shortcut: None),
        (id: "language-zh-Hant", title: "Chinese (Traditional)", shortcut: None),

        // M2's blocks and marks (docs/ROADMAP.md, M2 stage 2), by shortcut
        // until the designed chrome gives them places in the menus. Code
        // in runs is M, for monospace.
        (id: "code", title: "Code", shortcut: Some("Primary+Shift+M")),
        (id: "style-code", title: "Code Block", shortcut: Some("Primary+Shift+C")),
        (id: "list-bullets", title: "Bulleted List", shortcut: Some("Primary+Shift+8")),
        (id: "list-numbers", title: "Numbered List", shortcut: Some("Primary+Shift+7")),
        (id: "quote", title: "Quote", shortcut: Some("Primary+Shift+9")),
        (id: "insert-table", title: "Table", shortcut: Some("Primary+Shift+T")),

        // M2's stage 7, without places in the menus until the designed
        // chrome gives them some. A picture comes from a file chosen in
        // the system's dialog, and goes in the text at the caret.
        (id: "insert-picture", title: "Picture…", shortcut: None),
    ],
    menus: [
        (title: "File", items: ["new", "open", "-", "save-version", "-", "export-pdf", "print", "-", "quit"]),
        (title: "Edit", items: ["undo", "redo", "-", "cut", "copy", "paste", "-", "select-all"]),
        (title: "Format", items: [
            "bold", "italic", "-",
            "style-body", "style-heading-1", "style-heading-2", "style-heading-3", "-",
            "align-start", "align-center", "align-end", "align-justify", "-",
            "size-bigger", "size-smaller", "-",
            "size-9", "size-10", "size-11", "size-12", "size-14", "size-18", "size-24",
        ]),
        (title: "Language", items: [
            "language-en-US", "language-en-GB", "language-de", "language-fr", "language-es",
            "language-nb", "language-nn", "language-sv", "language-ru", "language-el", "-",
            "language-ar", "language-he", "-",
            "language-ja", "language-ko", "language-zh-Hans", "language-zh-Hant",
        ]),
    ],
)
