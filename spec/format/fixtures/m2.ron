// The session that wrote spec/format/fixtures/m2.xw with M2's code before
// stage 9, at commit e0db15b, the last that wrote schema 2 (README.md). It
// is kept as the record of how the fixture was made; tests open the
// fixture itself, never a file this writes now.
(
    size: (900, 700),
    copy: [("crates/app/tests/pictures/gradient.jpg", "gradient.jpg")],
    events: [
        Key("Primary+1"),
        Type("The M2 fixture"),
        Key("Enter"),
        Type("A document written by M2, kept to show that later versions open its "),
        Key("Primary+B"),
        Type("blocks"),
        Key("Primary+B"),
        Type(", its "),
        Key("Primary+I"),
        Type("marks"),
        Key("Primary+I"),
        Type(", its "),
        Key("Primary+Shift+M"),
        Type("code"),
        Key("Primary+Shift+M"),
        Type(", "),
        Key("Primary+Shift+X"),
        Type("struck"),
        Key("Primary+Shift+X"),
        Type(" text and its history."),
        Command("save-version"),
        Key("Enter"),
        Key("Primary+2"),
        Type("Lists, quotes and code"),
        Key("Enter"),
        Command("list-bullets"),
        Type("A bullet"),
        Key("Enter"),
        Type("and a nested one"),
        Key("Tab"),
        Key("Enter"),
        Key("Enter"),
        Key("Enter"),
        Command("list-numbers"),
        Type("One"),
        Key("Enter"),
        Type("Two"),
        Key("Enter"),
        Key("Enter"),
        Command("list-tasks"),
        Type("A task, done"),
        Key("Primary+Enter"),
        Key("Enter"),
        Key("Enter"),
        Command("quote"),
        Type("A quotation, quoted."),
        Key("Enter"),
        Key("Enter"),
        Type("let answer = 42;"),
        Key("Enter"),
        Type("After the code."),
        Key("Up"),
        Key("Primary+Shift+C"),
        Key("End"),
        Key("Shift+Enter"),
        Type("println!(\"{answer}\");"),
        Key("Primary+End"),
        Key("Enter"),
        Key("Primary+2"),
        Type("A table and a picture"),
        Key("Enter"),
        Command("insert-table"),
        Type("Name"),
        Key("Tab"),
        Type("Size"),
        Key("Tab"),
        Type("Pear"),
        Key("Tab"),
        Type("Small"),
        Key("Primary+End"),
        Key("Down"),
        Type("A picture: "),
        Command("insert-picture"),
        Choose(Some("gradient.jpg")),
        Key("Enter"),
        Key("Primary+2"),
        Type("Paragraphs of their own"),
        Key("Enter"),
        Type("Centred, spaced, indented and tabbed:\tand in German."),
        Key("Primary+E"),
        CommandWith("space-before", [Int(127000)]),
        CommandWith("indent-start", [Int(360000)]),
        CommandWith("line-height", [Int(1500)]),
        CommandWith("tab-stop-add", [Int(1800000), Text("center")]),
        Command("language-de"),
        Key("Enter"),
        Key("Primary+L"),
        Type("Larger"),
        Key("Shift+Home"),
        Command("size-14"),
        Key("End"),
        Key("Enter"),
        Key("Primary+3"),
        Type("Typed a word at a time"),
        Key("Enter"),
        Type("Every "),
        Type("word "),
        Type("of "),
        Type("this "),
        Type("paragraph "),
        Type("was "),
        Type("typed "),
        Type("as "),
        Type("a "),
        Type("step "),
        Type("of "),
        Type("its "),
        Type("own, "),
        Type("so "),
        Type("the "),
        Type("file's "),
        Type("log "),
        Type("runs "),
        Type("past "),
        Type("a "),
        Type("hundred "),
        Type("entries "),
        Type("and "),
        Type("holds "),
        Type("a "),
        Type("second "),
        Type("snapshot. "),
        Type("A "),
        Type("file "),
        Type("M2 "),
        Type("wrote "),
        Type("must "),
        Type("open "),
        Type("in "),
        Type("every "),
        Type("later "),
        Type("xWorks "),
        Type("with "),
        Type("the "),
        Type("same "),
        Type("blocks, "),
        Type("the "),
        Type("same "),
        Type("formatting "),
        Type("and "),
        Type("the "),
        Type("same "),
        Type("history."),
        Command("save-version"),
        Key("Enter"),
        Type("Undone, then redone, then undone again"),
        Key("Primary+Z"),
        Key("Primary+Z"),
        Key("Primary+Shift+Z"),
        Key("Primary+Z"),
    ],
    expect: [
        ("Heading 1", "The M2 fixture"),
        ("Body", "A document written by M2, kept to show that later versions open its blocks, its marks, its code, struck text and its history."),
        ("Heading 2", "Lists, quotes and code"),
        ("Body", "A bullet"),
        ("Body", "and a nested one"),
        ("Body", "One"),
        ("Body", "Two"),
        ("Body", "A task, done"),
        ("Body", "A quotation, quoted."),
        ("Code", "let answer = 42;\u{2028}println!(\"{answer}\");"),
        ("Body", "After the code."),
        ("Heading 2", "A table and a picture"),
        ("Body", "Name"),
        ("Body", "Size"),
        ("Body", "Pear"),
        ("Body", "Small"),
        ("Body", "A picture: \u{fffc}"),
        ("Heading 2", "Paragraphs of their own"),
        ("Body", "Centred, spaced, indented and tabbed:\tand in German."),
        ("Body", "Larger"),
        ("Heading 3", "Typed a word at a time"),
        ("Body", "Every word of this paragraph was typed as a step of its own, so the file's log runs past a hundred entries and holds a second snapshot. A file M2 wrote must open in every later xWorks with the same blocks, the same formatting and the same history."),
    ],
)
