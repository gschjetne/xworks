            visits: ["41>", "37>", "34>", "28>", "25>", "18>", "15>", "10>", "4>", "0>"],
        ),
        (from: "0>", by: NextSentence, visits: ["33<", "40<", "45<"]),
        (from: "45<", by: PreviousSentence, visits: ["41>", "34>", "0>"]),
    ],
    units: [
        ("5>", Word, 4, 9),
