// Cyrillic breaks like Latin; a word too long for what's left of a line
// starts the next, even if that leaves a short line.
(
    text: "Съешь же ещё этих мягких французских булок, да выпей чаю.",
    style: (family: "Noto Serif", language: "ru"),
    width: 118,
    fonts: [("Съешь же ещё этих мягких французских булок, да выпей чаю.", "Noto Serif")],
    lines: [
        (text: "Съешь же ещё этих ", width: 1470965, baseline: 162916, height: 207569),
        (text: "мягких ", width: 566166, baseline: 370485, height: 207569),
        (text: "французских ", width: 1012241, baseline: 578054, height: 207569),
        (text: "булок, да выпей ", width: 1239926, baseline: 785623, height: 207569),
        (text: "чаю.", width: 347320, baseline: 993192, height: 207569),
    ],
)
