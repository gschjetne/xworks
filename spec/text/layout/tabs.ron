// Tabs go to their stops: the text after a start stop begins at it (60
// points), after an end stop ends at it (150), after a centred one is
// centred on it (220), and after a decimal stop has its decimal point at
// it (300). Past the last stop, tabs go to default stops every 36 points
// beyond it: 324. Each line has one more tab than the one before, so its
// last tab goes to the next stop.
(
    text: "a\tStart\u{2028}b\t\tEnd\u{2028}c\t\t\tMiddle\u{2028}d\t\t\t\t12.50\u{2028}e\t\t\t\t\tf",
    style: (family: "Source Serif 4", language: "en"),
    width: 400,
    tabs: (
        stops: [(60, Start), (150, End), (220, Center), (300, Decimal('.'))],
        interval: 36,
    ),
    lines: [
        (text: "a\tStart\u{2028}"),
        (text: "b\t\tEnd\u{2028}"),
        (text: "c\t\t\tMiddle\u{2028}"),
        (text: "d\t\t\t\t12.50\u{2028}"),
        (text: "e\t\t\t\t\tf"),
    ],
    positions: [
        // Before "Start".
        ("2>", 762000),
        // After "End".
        ("14<", 1905000),
        // Before ".50".
        ("33>", 3810000),
        // Before "f".
        ("43>", 4114800),
    ],
    // "Middle", centred.
    middles: [("19>", "25<", 2794000)],
)
