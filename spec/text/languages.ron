// The language tag reaches the shaper: the same characters take each
// language's own forms, from the font's `locl` feature. Glyph IDs are those
// of the bundled fonts (fonts.ron), as HarfBuzz 14.6.0 shapes them.
[
    (
        about: "Serbian italic Cyrillic has its own forms of б, г, д, п and т",
        text: "бгдпт",
        style: (family: "Noto Serif", italic: true),
        glyphs: [
            ("sr", [2385, 2386, 2387, 2388, 2389]),
            ("ru", [458, 460, 461, 472, 475]),
        ],
    ),
    (
        about: "Serbian upright б differs from Russian",
        text: "бгдпт",
        style: (family: "Noto Serif"),
        glyphs: [
            ("sr", [2377, 460, 461, 472, 475]),
            ("ru", [458, 460, 461, 472, 475]),
        ],
    ),
    (
        about: "Han characters take Japanese, Korean, or Simplified or Traditional Chinese forms, in serif",
        text: "直骨",
        style: (family: "Noto Serif"),
        glyphs: [
            ("ja", [27755, 45051]),
            ("ko", [27755, 45051]),
            ("zh-Hans", [27756, 45052]),
            ("zh-Hant", [27756, 45053]),
            // The font's default is Simplified Chinese.
            ("und", [27756, 45052]),
        ],
    ),
    (
        about: "Han characters take Japanese, Korean, or Simplified or Traditional Chinese forms, in sans",
        text: "直骨",
        style: (family: "Noto Sans"),
        glyphs: [
            ("ja", [27873, 45132]),
            ("ko", [27873, 45132]),
            ("zh-Hans", [27874, 45133]),
            ("zh-Hant", [27874, 45134]),
            ("und", [27874, 45133]),
        ],
    ),
    (
        about: "Urdu writes four, six and seven its own way",
        text: "۴۶۷",
        style: (family: "Noto Serif"),
        glyphs: [
            ("ur", [156, 130, 157]),
            ("fa", [136, 138, 139]),
            ("ar", [136, 138, 139]),
        ],
    ),
    (
        about: "Romanian puts a comma, not a cedilla, under S and T",
        text: "ŞŢ",
        style: (family: "Noto Serif"),
        glyphs: [
            ("ro", [328, 291]),
