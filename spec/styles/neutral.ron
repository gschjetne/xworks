// Neutral, the stylesheet new documents take unless the person chooses
// another, and Markdown files' (docs/ARCHITECTURE.md, section 6): Source
// Serif 4 to read at length, and Inter for headings, as the chrome's
// mockups set them (project owner, 2026-10-22, review pysc65hp); Noto
// stands in for the scripts they lack. It's M2's look from before
// documents held their own styles, so their goldens hold. Paragraphs are
// ragged unless they're justified, and justified ones hyphenate.
//
// A document copies a stylesheet; this file is never read for one that
// has. Lengths are Pt(...), Mm(...) or In(...); colours are #rrggbb, or a
// colour below by name. `Some(...)` may be left out around a value.
(
    name: "Neutral",
    // Version 3 has Table Header, and gives every style and part a role,
    // so a document's own renamed still matches it (M2's stage 9's
    // follow-up, review sjj5ak5a). Version 2 has the room around a rule across the text
    // (M2's stage 6's follow-up, review jy4a2tx5), which the other sheets
    // take from it. Earlier versions are kept in versions/.
    version: 3,
    faces: [
        (name: "Text", role: "text", family: "Source Serif 4"),
        (name: "Heading", role: "heading", family: "Inter"),
        (name: "Code", role: "code", family: "JetBrains Mono"),
    ],
    colours: [
        (name: "Ink", role: "ink", colour: "#000000"),
        (name: "Link", role: "link", colour: "#1950aa"),
        (name: "Quote bar", role: "quote-bar", colour: "#c4c4c4"),
        (name: "Code tint", role: "code-tint", colour: "#f3f3f0"),
        (name: "Rule", role: "rule", colour: "#000000"),
        (name: "Hairline", role: "hairline", colour: "#c8c8c8"),
        // Where a picture the document shows can't be drawn, as when its
        // file lacks it.
        (name: "Missing picture", role: "missing-picture", colour: "#e6e6e2"),
    ],
    // Bullets by depth, over again deeper: characters every document face
    // has.
    lists: [
        (name: "Bullets", role: "bullets", bullets: ["•", "–"], indent: Pt(18), gap: Pt(6)),
        (name: "Numbers", role: "numbers", numbers: "1.", indent: Pt(18), gap: Pt(6)),
    ],
    // A4, with 25 mm margins all round.
    page: (width: Mm(210), height: Mm(297), top: Mm(25), bottom: Mm(25), left: Mm(25), right: Mm(25)),
    defaults: (face: "Text", size: Pt(11), colour: "Ink"),
    paragraph: [
        (name: "Body", role: "body", space_after: Pt(6)),
        (
            name: "Heading 1",
            role: "heading-1",
            based_on: "Heading",
            heading: 1,
            size: Pt(20),
            space_before: Pt(18),
            space_after: Pt(6),
        ),
        (
            name: "Heading 2",
            role: "heading-2",
            based_on: "Heading",
            heading: 2,
            size: Pt(15),
            space_before: Pt(14),
            space_after: Pt(4),
        ),
        (
            name: "Heading 3",
            role: "heading-3",
            based_on: "Heading",
            heading: 3,
            size: Pt(12.5),
            space_before: Pt(10),
            space_after: Pt(3),
        ),
        // Markdown's other three levels (M2's stage 6), in the body's size
        // and smaller.
        (
            name: "Heading 4",
            role: "heading-4",
            based_on: "Heading",
            heading: 4,
            space_before: Pt(8),
            space_after: Pt(2),
        ),
        (
            name: "Heading 5",
            role: "heading-5",
            based_on: "Heading",
            heading: 5,
            size: Pt(10),
            space_before: Pt(8),
            space_after: Pt(2),
        ),
        (
            name: "Heading 6",
            role: "heading-6",
            based_on: "Heading 5",
            heading: 6,
            italic: true,
        ),
        // A code block: its lines break at line separators, not at
        // paragraphs, and it's drawn on a tint, with no ligatures, so code
        // shows exactly what was typed (project owner, 2026-10-23, review
        // dcn5ejrd).
        (
            name: "Code",
            role: "code",
            code: true,
            face: "Code",
            ligatures: (standard: false, contextual: false),
            size: Pt(9.5),
            space_before: Pt(10),
            space_after: Pt(12),
        ),
        // A table's header row's paragraphs take it, as headings take
        // theirs (review sjj5ak5a): the body's text, bold, as header rows
        // were bold by their place before.
        (name: "Table Header", role: "table-header", based_on: "Body", bold: true),
        // What every heading shares, so their face and weight change in
        // one place; after the styles paragraphs take, as it's a base for
        // them. Headings, with their level for tagged PDF and
        // accessibility, keep with the paragraph after them.
        (name: "Heading", role: "heading", face: "Heading", bold: true, keep_with_next: true),
    ],
    // The marks: Markdown's emphasis, strong, code, links and lines
    // through text.
    character: [
        (name: "Emphasis", role: "emphasis", italic: true),
        (name: "Strong", role: "strong", bold: true),
        (name: "Code", role: "code", face: "Code", ligatures: (standard: false, contextual: false)),
        (name: "Link", role: "link", colour: "Link"),
        (name: "Strikethrough", role: "strikethrough", strikethrough: true),
    ],
    // Default tab stops every 12.5 mm; and how quotes, code and tables
    // look.
    document: (
        tab_interval: Mm(12.5),
        quote_indent: Pt(16),
        quote_bar: Pt(2.5),
        quote_colour: "Quote bar",
        code_tint: "Code tint",
        code_padding: Pt(5),
        table_space: Pt(8),
        cell_padding: Pt(4),
        rule: Pt(1),
        hairline: Pt(0.5),
        rule_colour: "Rule",
        hairline_colour: "Hairline",
        // A rule across the text, Markdown's thematic break: room above
        // and below its hairline, drawn in the rules' colour.
        rule_space: Pt(9),
        missing_picture: "Missing picture",
    ),
)
