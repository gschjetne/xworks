// Literary (M2's stage 9; project owner, 2026-10-24, review 30dmn1js):
// Alegreya, Juan Pablo del Peral's calligraphic book face, for essays,
// stories and letters. Ragged right, so the words keep their own spacing,
// on a wide margin with generous leading; headings in Alegreya's small
// capitals, and quotes set off by a quiet rule.
//
// Lengths are Pt(...), Mm(...) or In(...); colours are #rrggbb, or a
// colour below by name. `Some(...)` may be left out around a value.
(
    name: "Literary",
    version: 1,
    faces: [
        (name: "Text", role: "text", family: "Alegreya"),
        (name: "Heading", role: "heading", family: "Alegreya SC"),
        (name: "Code", role: "code", family: "JetBrains Mono"),
    ],
    colours: [
        // Warm browns, as of iron-gall ink.
        (name: "Ink", role: "ink", colour: "#2a241f"),
        (name: "Accent", role: "accent", colour: "#8c3b14"),
        (name: "Link", role: "link", colour: "#8c3b14"),
        (name: "Quote bar", role: "quote-bar", colour: "#d9cbb4"),
        (name: "Code tint", role: "code-tint", colour: "#f6f0e5"),
        (name: "Rule", role: "rule", colour: "#5a4c40"),
        (name: "Hairline", role: "hairline", colour: "#e1d6c4"),
        (name: "Missing picture", role: "missing-picture", colour: "#ece4d6"),
    ],
    lists: [
        (name: "Bullets", role: "bullets", bullets: ["–", "·"], indent: Pt(20), gap: Pt(6)),
        (name: "Numbers", role: "numbers", numbers: "1.", indent: Pt(20), gap: Pt(6)),
    ],
    // A4, its text a little under 140 mm wide.
    page: (width: Mm(210), height: Mm(297), top: Mm(30), bottom: Mm(34), left: Mm(36), right: Mm(36)),
    defaults: (face: "Text", size: Pt(12), colour: "Ink", line_height: 1380),
    paragraph: [
        (name: "Body", role: "body", space_after: Pt(7)),
        (name: "First Paragraph", role: "first", based_on: "Body"),
        (
            name: "Heading 1",
            role: "heading-1",
            based_on: "Heading",
            heading: 1,
            size: Pt(23),
            colour: "Accent",
            space_before: Pt(24),
            space_after: Pt(12),
        ),
        (
            name: "Heading 2",
            role: "heading-2",
            based_on: "Heading",
            heading: 2,
            size: Pt(15),
            space_before: Pt(20),
            space_after: Pt(6),
        ),
        (
            name: "Heading 3",
            role: "heading-3",
            based_on: "Heading",
            heading: 3,
            face: "Text",
            italic: true,
            size: Pt(13),
            space_before: Pt(14),
            space_after: Pt(4),
        ),
        (name: "Heading 4", role: "heading-4", based_on: "Heading 3", heading: 4, size: Pt(12)),
        (name: "Heading 5", role: "heading-5", based_on: "Heading 4", heading: 5, italic: false),
        (name: "Heading 6", role: "heading-6", based_on: "Heading 5", heading: 6, size: Pt(11)),
        (
            name: "Code",
            role: "code",
            code: true,
            face: "Code",
            ligatures: (standard: false, contextual: false),
            size: Pt(9.5),
            line_height: 1300,
            space_before: Pt(10),
            space_after: Pt(12),
        ),
        // What every heading shares: small capitals, kept with what
        // follows.
        (name: "Heading", face: "Heading", keep_with_next: true, line_height: 1150),
    ],
    character: [
        (name: "Emphasis", role: "emphasis", italic: true),
        (name: "Strong", role: "strong", bold: true),
        (name: "Code", role: "code", face: "Code", size: Pt(10), ligatures: (standard: false, contextual: false)),
        (name: "Link", role: "link", colour: "Link", underline: true),
        (name: "Strikethrough", role: "strikethrough", strikethrough: true),
    ],
    document: (
        tab_interval: Mm(12.5),
        quote_indent: Pt(22),
        quote_bar: Pt(1),
        quote_colour: "Quote bar",
        code_tint: "Code tint",
        code_padding: Pt(6),
        table_space: Pt(10),
        cell_padding: Pt(4),
        rule: Pt(0.8),
        hairline: Pt(0.4),
        rule_colour: "Rule",
        hairline_colour: "Hairline",
        missing_picture: "Missing picture",
    ),
)
