// M1's styles (docs/ROADMAP.md, M1 stage 7): one page style, which the
// canvas's automatic pages take, the paragraph styles a story's
// paragraphs name, and the document's tab stops. Lengths are Pt(...),
// Mm(...) or In(...).
//
// Text is Source Serif 4 and headings Inter (project owner, 2026-10-22,
// review pysc65hp): a book face to read at length, and a plain sans for
// headings, as the chrome's mockups set them; Noto stands in for the
// scripts they lack. Paragraphs are ragged unless they're justified, and
// justified ones hyphenate.
(
    // A4, with 25 mm margins all round.
    page: (
        width: Mm(210),
        height: Mm(297),
        top: Mm(25),
        bottom: Mm(25),
        left: Mm(25),
        right: Mm(25),
    ),
    // The first is the default, for paragraphs that name no style or one
    // that isn't here. Headings, with their level for tagged PDF and
    // accessibility, keep with the paragraph after them.
    paragraph: [
        (name: "Body", family: "Source Serif 4", size: Pt(11), space_after: Pt(6)),
        (
            name: "Heading 1",
            heading: Some(1),
            family: "Inter",
            size: Pt(20),
            bold: true,
            space_before: Pt(18),
            space_after: Pt(6),
            keep_with_next: true,
        ),
        (
            name: "Heading 2",
            heading: Some(2),
            family: "Inter",
            size: Pt(15),
            bold: true,
            space_before: Pt(14),
            space_after: Pt(4),
            keep_with_next: true,
        ),
        (
            name: "Heading 3",
            heading: Some(3),
            family: "Inter",
            size: Pt(12.5),
            bold: true,
            space_before: Pt(10),
            space_after: Pt(3),
            keep_with_next: true,
        ),
        // A code block (M2): its lines break at line separators, not at
        // paragraphs, and it's drawn on a tint.
        (
            name: "Code",
            code: true,
            family: "JetBrains Mono",
            // No ligatures, so code shows exactly what was typed (project
            // owner, 2026-10-23, review dcn5ejrd).
            ligatures: (standard: false, contextual: false),
            size: Pt(9.5),
            space_before: Pt(10),
            space_after: Pt(12),
        ),
    ],
    // Every paragraph's tab stops besides its style's: none set, and
    // default ones every 12.5 mm.
    tabs: (stops: [], interval: Mm(12.5)),
    // How the blocks M2 adds look: lists, quotes, code and tables. Colours
    // are sRGB.
    blocks: (
        list_indent: Pt(18),
        // Bullets by depth, over again deeper: characters every document
        // face has.
        bullets: ["•", "–"],
        marker_gap: Pt(6),
        quote_indent: Pt(16),
        quote_bar: Pt(2.5),
        quote_color: (196, 196, 196),
        code_family: "JetBrains Mono",
        code_ligatures: (standard: false, contextual: false),
        code_tint: (243, 243, 240),
        code_padding: Pt(5),
        table_space: Pt(8),
        cell_padding: Pt(4),
        rule: Pt(1),
        hairline: Pt(0.5),
        rule_color: (0, 0, 0),
        hairline_color: (200, 200, 200),
        link_color: (25, 80, 170),
    ),
)
