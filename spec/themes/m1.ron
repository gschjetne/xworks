// M1's look (docs/ROADMAP.md, M1 stage 9): the chrome's font, sizes and
// colours, and the desk behind the pages. It's a placeholder: the UX design
// stage that opens F5 settles the look (project owner, 2026-10-22, review
// v0qk8k5d). Lengths are Pt(...) or Px(...), pixels at 96 to the inch;
// colours are Rgb(red, green, blue) or Rgba(..., opacity), each 0 to 255.
(
    family: "Noto Sans",
    size: Pt(9.5),
    // The menu bar's and status bar's height, a menu item's, and the space
    // at a label's sides.
    bar_height: Px(26),
    item_height: Px(24),
    padding: Px(10),
    // The bars.
    background: Rgb(240, 240, 238),
    // Menus and panels.
    surface: Rgb(255, 255, 255),
    ink: Rgb(20, 20, 20),
    // Commands that can't be chosen.
    disabled: Rgb(165, 165, 165),
    // Text that says less, such as shortcuts.
    secondary: Rgb(105, 105, 105),
    // What's under the pointer, or open, and the text on it.
    highlight: Rgb(40, 90, 200),
    highlight_ink: Rgb(255, 255, 255),
    // Lines between things.
    line: Rgb(200, 200, 196),
    // Behind the pages.
    desk: Rgb(200, 201, 204),
    // The selection, over the text.
    selection: Rgba(60, 120, 230, 80),
)
