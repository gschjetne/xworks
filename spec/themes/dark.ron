// The dark look's colours, by role, as light.ron names them (the approved
// mockups, review 3ce247c2): pages stay white, and the draft view's text
// takes the ink.
(
    desk: Rgb(30, 30, 28),
    chrome: Rgb(38, 38, 36),
    line: Rgb(58, 57, 54),
    ink: Rgb(236, 235, 230),
    secondary: Rgb(163, 161, 154),
    disabled: Rgb(104, 102, 97),
    hover: Rgb(51, 50, 47),
    accent: Rgb(110, 151, 232),
    field: Rgb(30, 30, 28),
    field_line: Rgb(66, 65, 61),
    shadow: Rgba(0, 0, 0, 90),
    selection: Rgba(110, 151, 232, 90),
    danger: Rgb(196, 43, 28),
    page: Rgb(255, 255, 255),
    page_ink: Rgb(0, 0, 0),
)
